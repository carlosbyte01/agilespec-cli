{
    "name": "@agilespec/cli",
    "version": "0.0.3",
    "description": "The command-line interface for the AgileSpec framework, standardizing AI-driven development workflows.",
    "main": "index.js",
    "type": "module",
    "bin": {
        "agilespec": "bin/index.js"
    },
    "files": [
        "agents/",
        "assets/",
        "bin/",
        "lib/",
        "templates/"
    ],
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
